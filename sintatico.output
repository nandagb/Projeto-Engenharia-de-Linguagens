Grammar

    0 $accept: prog $end

    1 prog: func_declaration_list
    2     | general_stmt_list func_declaration_list

    3 general_stmt: var_declaration
    4             | list_initialization
    5             | struct_declaration
    6             | var_initialization

    7 general_stmt_list: general_stmt ';'
    8                  | general_stmt_list general_stmt ';'

    9 func_declaration_list: func_declaration
   10                      | func_declaration_list func_declaration

   11 func_declaration: type FUNCTION ID '(' params_list ')' '{' stmt_list '}'

   12 stmt_list: stmt
   13          | stmt_list stmt

   14 stmt: general_stmt ';'
   15     | access_assign ';'
   16     | var_assign ';'
   17     | list_assign ';'
   18     | func_declaration
   19     | if
   20     | return ';'
   21     | BREAK ';'
   22     | CONTINUE ';'
   23     | while
   24     | do_while ';'
   25     | for
   26     | expression ';'
   27     | write ';'
   28     | switch
   29     | list_push ';'
   30     | list_remove ';'

   31 return: RETURN
   32       | RETURN expression

   33 params_list: ε
   34            | var_declaration_list

   35 var_initialization: primitive_type ID '=' expression

   36 var_declaration: primitive_type ID
   37                | list_declaration
   38                | ID ID

   39 var_declaration_list: var_declaration
   40                     | var_declaration_list ',' var_declaration

   41 list_declaration: LIST '<' list_types '>' ID

   42 list_types: primitive_type
   43           | ID
   44           | LIST '<' list_types '>'

   45 list_initialization: list_declaration '=' NEW LIST '<' '>' '(' ')'
   46                    | list_declaration '=' NEW LIST '<' '>' '(' ID ')'

   47 list_assign: ID '=' NEW LIST '<' '>' '(' ')'
   48            | ID '=' NEW LIST '<' '>' '(' ID ')'

   49 list_push: ID access_suffix_list '.' ADD '(' expression ')'
   50          | ID '.' ADD '(' expression ')'

   51 list_remove: ID access_suffix_list '.' REMOVE '(' ')'
   52            | ID '.' REMOVE '(' ')'

   53 access_assign: access '=' expression

   54 access: ID access_suffix_list

   55 access_suffix_list: access_suffix
   56                   | access_suffix_list access_suffix

   57 access_suffix: '[' expression ']'
   58              | '.' ID

   59 int_literal: INT_LITERAL
   60            | '-' INT_LITERAL

   61 float_literal: FLOAT_LITERAL
   62              | '-' FLOAT_LITERAL

   63 type: primitive_type
   64     | LIST '<' list_types '>'
   65     | STRUCT

   66 primitive_type: INTEGER
   67               | FLOAT
   68               | STRING
   69               | VOID
   70               | BOOLEAN

   71 struct_declaration: STRUCT ID '=' '{' var_declaration_list '}'

   72 var_assign: ID '=' expression
   73           | ID composite_assign_operator expression

   74 composite_assign_operator: SUM_ASSIGN
   75                          | SUBTRACTION_ASSIGN
   76                          | TIMES_ASSIGN
   77                          | DIVISION_ASSIGN

   78 expression: expression AND comparison_expression
   79           | expression OR comparison_expression
   80           | comparison_expression

   81 comparison_expression: comparison_expression EQUALS relation_expression
   82                      | comparison_expression DIFF relation_expression
   83                      | relation_expression

   84 relation_expression: relation_expression '>' arithmatic_expression
   85                    | relation_expression '<' arithmatic_expression
   86                    | relation_expression GTE arithmatic_expression
   87                    | relation_expression LTE arithmatic_expression
   88                    | arithmatic_expression

   89 arithmatic_expression: arithmatic_expression '+' factor
   90                      | arithmatic_expression '-' factor
   91                      | factor

   92 factor: factor '*' unary
   93       | factor '/' unary
   94       | factor INT_DIVISION unary
   95       | unary

   96 unary: ID UNARY_SUM
   97      | ID UNARY_SUBTRACTION
   98      | '(' expression ')'
   99      | ID
  100      | int_literal
  101      | float_literal
  102      | BOOL_LITERAL
  103      | STRING_LITERAL
  104      | func_call
  105      | read
  106      | access

  107 func_call: ID '(' args ')'

  108 args: args ',' expression
  109     | expression
  110     | ε

  111 if: IF '(' expression ')' '{' stmt_list '}' if_complement

  112 if_complement: ELSE '{' stmt_list '}'
  113              | else_if
  114              | else_if ELSE '{' stmt_list '}'
  115              | ε

  116 else_if: else_if ELSE_IF '(' expression ')' '{' stmt_list '}'
  117        | ELSE_IF '(' expression ')' '{' stmt_list '}'

  118 switch: SWITCH '(' ID ')' '{' cases DEFAULT ':' stmt_list '}'
  119       | SWITCH '(' ID ')' '{' cases '}'

  120 cases: cases case
  121      | case

  122 case: CASE expression ':' stmt_list

  123 while: WHILE '(' expression ')' '{' stmt_list '}'

  124 do_while: DO '{' stmt_list '}' WHILE '(' expression ')'

  125 for_initialization: var_initialization
  126                   | var_assign

  127 for_step: var_assign
  128         | expression

  129 for: FOR '(' for_initialization ',' expression ',' for_step ')' '{' stmt_list '}'

  130 read: INPUT '(' input_args ')'

  131 write: OUTPUT '(' expression ')'

  132 input_args: ε
  133           | STRING_LITERAL


